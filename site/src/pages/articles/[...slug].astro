---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CardCta from '../../components/CardCta.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, date, excerpt, ctaCardKey } = article.data;
---

<ArticleLayout title={`${title} | 海外ラウンジガイド`} description={excerpt}>
  <article>
    <h1>{title}</h1>
    <p>
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
    </p>
    <Content />
    <CardCta cardKey={ctaCardKey} campaign={article.slug} />
  </article>
</ArticleLayout>
